# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# TickTick — three supported auth paths (see docs/integrations.md). Set what you use.
# 1) MCP token (primary): TickTick Web > Settings > Account > API Token.
TICKTICK_MCP_TOKEN=
# 2) V2 web session — needed for Inbox tasks (account username + password).
TICKTICK_USERNAME=
TICKTICK_PASSWORD=
# 3) V1 Open API access token (no Inbox access).
TICKTICK_ACCESS_TOKEN=
# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Strava (free public API — no subscription required)
# OAuth refresh-token flow, same pattern as Spotify/Google. See docs/integrations.md.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Stocks
# FINNHUB_API_KEY is required for quotes (free tier). TWELVEDATA_API_KEY is
# optional — it only adds the sparkline mini-chart; quotes work without it.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Fund (Israeli mutual fund via Maya/TASE) — no key needed; public JSON API.
# Fund number is set per-client (native: Settings; default 5140785).

# GitHub
GITHUB_PAT=
GITHUB_USERNAME=

# Notion
NOTION_TOKEN=
NOTION_READING_DATA_SOURCE_ID=
NOTION_RESOURCES_DB_ID=31f86eb0-7b69-801f-ad6b-f5bb18cd2dae
NOTION_PROJECTS_DB_ID=4261f331-2614-4fc6-941c-fb33a247741f

# IBKR (official local Client Portal Gateway)
IBKR_DATA_SOURCE=auto
IBKR_GATEWAY_URL=https://localhost:5001
IBKR_ACCOUNT_ID=
IBKR_KEEPALIVE_INTERVAL_MS=60000

# IBKR persistent read-only snapshots via official Flex Web Service
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_CACHE_MS=900000
# AI
GROQ_API_KEY=
