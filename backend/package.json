{
  "name": "sky-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Headless Next.js backend for Sky. Serves /api/* on http://localhost:3000 for the native and (frozen) web clients. lib/types.ts is the API contract source.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ibkr:setup": "bash scripts/ibkr/setup-gateway.sh",
    "ibkr:start": "bash scripts/ibkr/start-gateway.sh",
    "ibkr:status": "node scripts/ibkr/status.mjs",
    "ibkr:keepalive": "node scripts/ibkr/keepalive.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "groq-sdk": "^1.2.1",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "typescript": "^5"
  }
}
