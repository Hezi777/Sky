# IBKR via SnapTrade (hosted aggregator — no local gateway required)
# Sign up at https://dashboard.snaptrade.com to get clientId and consumerKey.
# Then run: npx ts-node scripts/snaptrade-setup.ts
# That script prints your SNAPTRADE_USER_SECRET and SNAPTRADE_ACCOUNT_ID.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=hen
SNAPTRADE_USER_SECRET=
SNAPTRADE_ACCOUNT_ID=

