# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (nested-aware: backend/, legacy-web/ each have their own)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (nested-aware)
.next/
out/

# electron (nested-aware)
release/
electron-dist/

# native SwiftUI / XcodeGen
/native/Sky.xcodeproj/
/native/.build/
/native/.build-ios/
/native/DerivedData/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local broker gateway binaries
/tools/ibkr/

# source design assets (raw character art, icon sources)
assets/source/

# build output
output/
native/output/
native/Sky/Debug/
